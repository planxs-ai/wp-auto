# Supabase (필수)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# 서버 전용. 관리자 확인(대시보드 진입, /api/setup, /api/etf-report)에 쓴다. 없으면 500 을 돌려준다.
# Production 에만, Sensitive 로 넣는다.
SUPABASE_SERVICE_KEY=your_service_role_key_here
# 서버 전용. 관리자 auth.users id 허용 목록 (쉼표 구분). user_profiles.role='admin' 과 둘 다 맞아야 통과한다.
# 비어 있으면 아무도 관리자로 인정하지 않는다 (대시보드·관리자 API 모두 500).
ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000

# GitHub (선택 — 대시보드의 발행·ETF 버튼용. 없으면 두 버튼만 멈추고 gh CLI 로 대신 실행)
# 이 저장소 하나에 Actions 쓰기 권한만 준 fine-grained 토큰을 권장
GITHUB_TOKEN=github_pat_your_token
GITHUB_REPO=planxs-ai/wp-auto

# 대시보드에서 실제 발행(dry_run=false) 허용 스위치. 'true' 일 때만 열린다.
# AdSense 심사 기간(새 글 0)에는 넣지 않는다 — 테스트 실행만 가능
PUBLISH_DISPATCH_ENABLED=false
